# MongoDB Atlas veya yerel MongoDB bağlantı adresi
MONGODB_URI=mongodb+srv://KULLANICI:SIFRE@CLUSTER_ADRESI/asea?retryWrites=true&w=majority

# ASEA'nın kullanacağı veritabanı adı
MONGODB_DB=asea

# Yalnızca yerel DNS, Atlas SRV sorgularını engelliyorsa virgülle ayır
MONGODB_DNS_SERVERS=

# Gerçek kimlik doğrulama eklenene kadar yerel geliştirme kullanıcısı
ASEA_DEMO_USER_ID=demo-onur
