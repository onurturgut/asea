{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asea.dev/schemas/kos/concept.schema.json",
  "title": "ASEA Concept Record",
  "allOf": [
    {
      "$ref": "./common.schema.json#/$defs/baseRecord"
    },
    {
      "type": "object",
      "required": [
        "definition",
        "purpose",
        "history",
        "mental_model",
        "analogy",
        "terminology",
        "relationships",
        "prerequisite_ids",
        "real_world_usage",
        "common_mistakes",
        "industry_notes",
        "ai_notes",
        "interview_notes",
        "exercise_candidates",
        "lab_candidates",
        "project_candidates",
        "claim_ids",
        "learning_outcome_ids",
        "difficulty",
        "knowledge_area"
      ],
      "properties": {
        "record_type": {
          "const": "concept"
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "history": {
          "type": "string",
          "minLength": 1
        },
        "mental_model": {
          "type": "string",
          "minLength": 1
        },
        "analogy": {
          "type": "string",
          "minLength": 1
        },
        "terminology": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prerequisite_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "real_world_usage": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "common_mistakes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "industry_notes": {
          "type": "string",
          "minLength": 1
        },
        "ai_notes": {
          "type": "string",
          "minLength": 1
        },
        "interview_notes": {
          "type": "string",
          "minLength": 1
        },
        "exercise_candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "lab_candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "project_candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "claim_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^ASEA-CLM-[0-9]{6}$"
          }
        },
        "learning_outcome_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "difficulty": {
          "enum": [
            "Beginner",
            "Intermediate",
            "Advanced"
          ]
        },
        "knowledge_area": {
          "type": "string",
          "minLength": 1
        }
      },
      "unevaluatedProperties": false
    }
  ]
}
