{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asea.dev/schemas/kos/claim.schema.json",
  "title": "ASEA Claim Record",
  "allOf": [
    {
      "$ref": "./common.schema.json#/$defs/baseRecord"
    },
    {
      "type": "object",
      "required": [
        "proposition",
        "scope",
        "exceptions",
        "evidence_ids",
        "academic_score",
        "official_score",
        "industry_score",
        "community_score",
        "confidence_score",
        "freshness_score",
        "evidence_count",
        "confidence_components",
        "score_rationale",
        "contradiction_ids",
        "next_review_on",
        "review_decision"
      ],
      "properties": {
        "record_type": {
          "const": "claim"
        },
        "proposition": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^ASEA-EV-[0-9]{6}$"
          }
        },
        "academic_score": {
          "$ref": "./common.schema.json#/$defs/scoreFive"
        },
        "official_score": {
          "$ref": "./common.schema.json#/$defs/scoreFive"
        },
        "industry_score": {
          "$ref": "./common.schema.json#/$defs/scoreFive"
        },
        "community_score": {
          "$ref": "./common.schema.json#/$defs/scoreFive"
        },
        "confidence_score": {
          "$ref": "./common.schema.json#/$defs/scoreHundred"
        },
        "freshness_score": {
          "$ref": "./common.schema.json#/$defs/scoreHundred"
        },
        "evidence_count": {
          "type": "integer",
          "minimum": 1
        },
        "confidence_components": {
          "type": "object",
          "required": [
            "authority",
            "directness",
            "independence",
            "reproducibility",
            "consistency",
            "scope_clarity"
          ],
          "properties": {
            "authority": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "directness": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "independence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "reproducibility": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "consistency": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "scope_clarity": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          "additionalProperties": false
        },
        "score_rationale": {
          "type": "string",
          "minLength": 1
        },
        "contradiction_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^ASEA-CTR-[0-9]{6}$"
          }
        },
        "next_review_on": {
          "type": "string",
          "format": "date"
        },
        "review_decision": {
          "enum": [
            "Approved",
            "Changes Required",
            "Rejected"
          ]
        }
      },
      "unevaluatedProperties": false
    }
  ]
}
