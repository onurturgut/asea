{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asea.dev/schemas/kos/edge.schema.json",
  "title": "ASEA Knowledge Graph Edge",
  "allOf": [
    {
      "$ref": "./common.schema.json#/$defs/baseRecord"
    },
    {
      "type": "object",
      "required": [
        "source_concept_id",
        "target_id",
        "relation_type",
        "rationale",
        "evidence_or_decision_ids"
      ],
      "properties": {
        "record_type": {
          "const": "edge"
        },
        "source_concept_id": {
          "type": "string",
          "pattern": "^ASEA-CON-[0-9]{6}$"
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "relation_type": {
          "enum": [
            "prerequisite-of",
            "depends-on",
            "related-to",
            "enables",
            "next-concept",
            "practiced-by",
            "assessed-by",
            "evidenced-by",
            "supersedes"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidence_or_decision_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "unevaluatedProperties": false
    }
  ]
}
