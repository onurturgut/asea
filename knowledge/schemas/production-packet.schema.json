{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asea.dev/schemas/kos/production-packet.schema.json",
  "title": "ASEA Chapter Production Packet",
  "allOf": [
    {
      "$ref": "./common.schema.json#/$defs/baseRecord"
    },
    {
      "type": "object",
      "required": [
        "chapter_id",
        "chapter_version",
        "blueprint_id",
        "learning_outcome_ids",
        "prerequisite_ids",
        "source_ids",
        "evidence_ids",
        "claim_ids",
        "concept_ids",
        "graph_version",
        "required_components",
        "required_asset_types",
        "assessment_alignment",
        "accessibility_requirements",
        "known_risks",
        "exclusions",
        "review_owners",
        "production_decision"
      ],
      "properties": {
        "record_type": {
          "const": "production-packet"
        },
        "chapter_id": {
          "type": "string",
          "pattern": "^V[0-9]{2}-C[0-9]{2}$"
        },
        "chapter_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "blueprint_id": {
          "type": "string",
          "minLength": 1
        },
        "learning_outcome_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "prerequisite_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^ASEA-SRC-[0-9]{6}$"
          }
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^ASEA-EV-[0-9]{6}$"
          }
        },
        "claim_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^ASEA-CLM-[0-9]{6}$"
          }
        },
        "concept_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^ASEA-CON-[0-9]{6}$"
          }
        },
        "graph_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "required_components": {
          "type": "array",
          "minItems": 22,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "required_asset_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "assessment_alignment": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "outcome_id",
              "concept_ids",
              "practice_artifact_ids",
              "assessment_id",
              "acceptance_evidence"
            ]
          }
        },
        "accessibility_requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "known_risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclusions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "review_owners": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "production_decision": {
          "enum": [
            "Authorized",
            "Changes Required",
            "Rejected"
          ]
        }
      },
      "unevaluatedProperties": false
    }
  ]
}
