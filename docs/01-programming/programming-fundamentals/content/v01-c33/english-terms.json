  "terms": [
    {"term":"closure","turkish":"kapanış","explanation":"Function'ın oluşturulduğu lexical çevredeki bindings'e erişim davranışı.","firstUseContext":"createCounter","example":"increment accesses count","confusedWith":"inner function syntax","revisitAt":"V01-C37"},
    {"term":"lexical environment","turkish":"sözcüksel çevre","explanation":"Lexical nesting'e göre identifier bindings ve outer ilişki modeli.","firstUseContext":"E1 diagram","example":"E1 { count: 0 }","confusedWith":"heap object","revisitAt":"V01-C37"},
    {"term":"environment record","turkish":"çevre kaydı","explanation":"Specification'ın identifier bindings'i modelleyen mekanizması.","firstUseContext":"ECMA model","example":"function environment","confusedWith":"JS-accessible object","revisitAt":"V01-C37"},
    {"term":"outer environment","turkish":"dış çevre","explanation":"Identifier aramasında bir sonraki lexical environment bağlantısı.","firstUseContext":"count resolution","example":"local → E1","confusedWith":"caller","revisitAt":"V01-C37"},
    {"term":"capture","turkish":"yakalama","explanation":"Function'ın dış lexical binding erişimini koruması için kullanılan anlatım.","firstUseContext":"threshold binding","example":"rule reads threshold","confusedWith":"value copy","revisitAt":"V01-C37"},
    {"term":"captured binding","turkish":"erişimi korunan bağ","explanation":"Closure body'nin dış environment'ta çözdüğü binding.","firstUseContext":"count","example":"E1.count","confusedWith":"snapshot","revisitAt":"V01-P07"},
    {"term":"lifetime","turkish":"yaşam süresi","explanation":"State veya value'ya erişimin anlamlı/erişilebilir kaldığı zaman boyutu.","firstUseContext":"outer return","example":"F1 remains reachable","confusedWith":"scope","revisitAt":"V01-C37"},
    {"term":"reachability","turkish":"erişilebilirlik ilişkisi","explanation":"Programdaki referans yollarıyla bir value/state'e ulaşılabilmesi.","firstUseContext":"returned function","example":"counter → F1 → E1","confusedWith":"scope visibility","revisitAt":"V01-C37"},
    {"term":"retention","turkish":"erişimin sürmesi","explanation":"Captured graph'ın reachable closure nedeniyle yaşamaya devam etmesi.","firstUseContext":"memory orientation","example":"registered callback","confusedWith":"kesin leak","revisitAt":"V01-C37"},
