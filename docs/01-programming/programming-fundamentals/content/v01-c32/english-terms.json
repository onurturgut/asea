    {"term":"adapter function","turkish":"uyarlayıcı fonksiyon","explanation":"İki çağrı sözleşmesinin argument anlamlarını eşleyen wrapper.","firstUseContext":"map parse adapter","example":"value => parseInt(value, 10)","confusedWith":"duplicate logic","revisitAt":"V01-P07"},
