    {"term":"invocation order","turkish":"çağrı sırası","explanation":"Birden fazla callback call'un gerçekleşme düzeni.","firstUseContext":"rule sonra formatter","example":"validate → transform","confusedWith":"output sort order","revisitAt":"V01-P07"},
