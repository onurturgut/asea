    {"term":"input size","turkish":"girdi büyüklüğü","explanation":"Problemin ölçeğini temsil eden nicelik.","firstUseContext":"n değişkeni","example":"chapterIds.length","confusedWith":"dosya boyutu","revisitAt":"V01-C24"},
    {"term":"cost model","turkish":"maliyet modeli","explanation":"Analizde hangi temel işlemin sayılacağını belirleyen kabul.","firstUseContext":"karşılaştırma sayımı","example":"target === values[i]","confusedWith":"para maliyeti","revisitAt":"V01-C26"},
    {"term":"operation count","turkish":"işlem sayısı","explanation":"Seçilen temel işlemin kaç kez yürütüldüğü.","firstUseContext":"çalışma izi","example":"comparisons = 4","confusedWith":"çalışma süresi","revisitAt":"V01-C24"},
    {"term":"time complexity","turkish":"zaman karmaşıklığı","explanation":"Girdi büyürken gereken işin nasıl büyüdüğünü anlatan model.","firstUseContext":"büyüme tablosu","example":"Θ(n)","confusedWith":"milisaniye","revisitAt":"V01-C24"},
    {"term":"space complexity","turkish":"alan karmaşıklığı","explanation":"Girdi büyürken kullanılan belleğin büyümesi.","firstUseContext":"kopya dizi","example":"O(n) extra space","confusedWith":"disk kapasitesi","revisitAt":"V01-C24"},
    {"term":"asymptotic analysis","turkish":"asimptotik analiz","explanation":"Girdi çok büyürken baskın büyüme davranışını inceleme.","firstUseContext":"sabitleri ayırma","example":"3n + 2 → Θ(n)","confusedWith":"tek benchmark","revisitAt":"V01-C24"},
    {"term":"upper bound","turkish":"üst sınır","explanation":"Büyümenin aşmayacağını belirten asimptotik sınır.","firstUseContext":"Big O","example":"O(n²)","confusedWith":"tam eşitlik","revisitAt":"V01-C26"},
    {"term":"lower bound","turkish":"alt sınır","explanation":"Büyümenin altına düşmeyeceğini belirten asimptotik sınır.","firstUseContext":"Big Omega","example":"Ω(1)","confusedWith":"en kötü durum","revisitAt":"V01-C26"},
    {"term":"tight bound","turkish":"sıkı sınır","explanation":"Üst ve alt sınırın aynı büyüme ailesinde buluşması.","firstUseContext":"Big Theta","example":"Θ(n)","confusedWith":"yaklaşık süre","revisitAt":"V01-C26"},
